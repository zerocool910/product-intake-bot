# Copy to .env and fill in. Never commit .env.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot.
# Unknown users get a reply with their ID, so you can add them here.
ALLOWED_USER_IDS=

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional override; default claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Google service-account JSON key. Share the spreadsheet with the
# service account's email (Editor).
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/product-intake-bot/google-service-account.json
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
SHEET_WORKSHEET=Intake

# Logging. The service always logs to the journal (journalctl / intakebotctl logs).
# LOG_FILE adds a plain file, rotated at midnight, LOG_KEEP_DAYS days kept.
LOG_FILE=/var/log/product-intake-bot/bot.log
LOG_KEEP_DAYS=30
# LOG_LEVEL=INFO   (DEBUG for troubleshooting)

# Photos + SQLite live here. Back this folder up.
# DATA_DIR=/opt/product-intake-bot/data
