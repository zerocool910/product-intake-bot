# systemd unit for the product intake bot. Install with:
#   sudo scripts/intakebotctl install
# or by hand:
#   sudo cp deploy/product-intake-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now product-intake-bot
#
# Logs go to the journal (journalctl -u product-intake-bot) and, with
# LOG_FILE set in .env, to /var/log/product-intake-bot/bot.log (rotated daily).

[Unit]
Description=Product intake Telegram bot
After=network-online.target
Wants=network-online.target
# Give up restarting if it crashes 10 times within 5 minutes (e.g. bad .env).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=intakebot
Group=intakebot
WorkingDirectory=/opt/product-intake-bot
ExecStart=/opt/product-intake-bot/.venv/bin/python -m intake_bot
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
# Telegram long-polling can take a few seconds to wind down.
TimeoutStopSec=30

# Creates /var/log/product-intake-bot owned by intakebot.
LogsDirectory=product-intake-bot
SyslogIdentifier=product-intake-bot

# Hardening: the bot only needs to write its own folder and log folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/product-intake-bot /var/log/product-intake-bot

[Install]
WantedBy=multi-user.target
